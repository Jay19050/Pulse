+float SpectrumAnalyzer::frequencyForPoint(int pointIndex, double sr) noexcept
+{
+    const float t = static_cast<float>(pointIndex) / static_cast<float>(spectrumPoints - 1);
+
+    const float minHz = minFrequencyHz;
+    const float maxHz = static_cast<float>((sr > 0.0 ? sr : 48000.0) * 0.5);
+
+    const float shapedT = std::pow(t, frequencyShape);
+    return minHz * std::pow(maxHz / minHz, shapedT);
+}
+
+float SpectrumAnalyzer::positionForFrequency(float hz, double sr) noexcept
+{
+    const float minHz = minFrequencyHz;
+    const float maxHz = static_cast<float>((sr > 0.0 ? sr : 48000.0) * 0.5);
+
+    if (hz <= 0.0f || maxHz <= minHz)
+        return -1.0f;
+
+    const float ratio = std::log(hz / minHz) / std::log(maxHz / minHz);
+
+    if (ratio <= 0.0f)
+        return ratio < 0.0f ? -1.0f : 0.0f;
+
+    return std::pow(ratio, 1.0f / frequencyShape);
+}
