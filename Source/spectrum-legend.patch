     static constexpr int fftSize = 1 << fftOrder;
     static constexpr int spectrumPoints = 512;
 
+    // ---------------------------------------------------------------------
+    // Constants that define what the three traces in Snapshot MEAN.
+    //
+    // These used to be bare literals inside processBlock()/rebuildFrequency-
+    // Mapping() (and duplicated, with a comment, in VisualizerComponent's dB
+    // readout). They are named here - with exactly the same values - so the
+    // Spectrum legend, dB axis and hover readout are derived from the single
+    // source of truth instead of a second copy that can silently drift.
+    // ---------------------------------------------------------------------
+
+    // 50% overlap: one new spectrum every hopSize input samples.
+    static constexpr int hopSize = fftSize / 2;
+
+    // Analysed level (dB) -> 0..1 trace value: 0 == displayFloorDb,
+    // 1 == displayFloorDb + displaySpanDb. Values beyond either end are clamped.
+    static constexpr float displayFloorDb = -70.0f;
+    static constexpr float displaySpanDb  = 55.0f;
+
+    // Per-block envelope coefficients (one block == hopSize samples).
+    static constexpr float fastHold  = 0.70f;   // LIVE: retained fraction of the previous value...
+    static constexpr float fastDecay = 0.992f;  // ...then this extra per-block decay
+    static constexpr float avgCoeff  = 0.055f;  // AVG: one-pole follow of LIVE
+    static constexpr float peakDecay = 0.996f;  // PEAK: per-block decay of the held value
+
+    // Frequency mapping of the 512 points: 20 Hz .. Nyquist, with the point
+    // position shaped by t^frequencyShape. This is NOT a plain log axis - see
+    // frequencyForPoint()/positionForFrequency().
+    static constexpr float minFrequencyHz = 20.0f;
+    static constexpr float frequencyShape = 0.72f;
+
+    static float dbForNormalised(float normalised) noexcept
+    {
+        return normalised * displaySpanDb + displayFloorDb;
+    }
+
+    static float normalisedForDb(float db) noexcept
+    {
+        return (db - displayFloorDb) / displaySpanDb;
+    }
+
+    // Frequency (Hz) that spectrum point `pointIndex` represents at `sampleRate`.
+    // This is the exact mapping prepare() bakes into binIndex0/binFrac.
+    static float frequencyForPoint(int pointIndex, double sampleRate) noexcept;
+
+    // Inverse of frequencyForPoint(): the position along the point axis, as a
+    // fraction 0..1 of the plot width, at which `hz` is actually drawn. Returns
+    // a value <0 or >1 when `hz` lies outside the analysed range.
+    static float positionForFrequency(float hz, double sampleRate) noexcept;
+
     struct Snapshot
     {
         std::array<float, spectrumPoints> fast {};
