+void VisualizerComponent::rebuildThirdOctaveTables()
+{
+    constexpr int n = SpectrumAnalyzer::spectrumPoints;
+
+    std::array<double, n> lnFreq {};
+
+    for (int p = 0; p < n; ++p)
+        lnFreq[(size_t) p] = std::log((double) SpectrumAnalyzer::frequencyForPoint(p, sampleRate));
+
+    for (int p = 0; p < n; ++p)
+    {
+        const double hz = std::exp(lnFreq[(size_t) p]);
+
+        // Window in POINT indices covering hz / 2^(1/6) .. hz * 2^(1/6), via the
+        // analyzer's own frequency mapping. Clamped to the analysed range, so the
+        // window simply narrows at the ends.
+        const float posLo = SpectrumAnalyzer::positionForFrequency((float) (hz / kHalfThirdOctave), sampleRate);
+        const float posHi = SpectrumAnalyzer::positionForFrequency((float) (hz * kHalfThirdOctave), sampleRate);
+
+        int lo = posLo <= 0.0f ? 0 : (int) std::ceil(posLo * (float) (n - 1));
+        int hi = posHi >= 1.0f ? n - 1 : (int) std::floor(posHi * (float) (n - 1));
+
+        bandLo[(size_t) p] = juce::jlimit(0, p, lo);
+        bandHi[(size_t) p] = juce::jlimit(p, n - 1, hi);
+
+        // The points are not evenly spaced in log-frequency, so weight each by the log-
+        // frequency span it covers: the average is then over frequency-on-a-log-axis,
+        // not over however many points happen to fall in the window.
+        const double prev = lnFreq[(size_t) juce::jmax(p - 1, 0)];
+        const double nxt  = lnFreq[(size_t) juce::jmin(p + 1, n - 1)];
+        bandWeight[(size_t) p] = (float) (0.5 * (nxt - prev));
+    }
+
+    prefixWeight[0] = 0.0;
+
+    for (int p = 0; p < n; ++p)
+        prefixWeight[(size_t) p + 1] = prefixWeight[(size_t) p] + (double) bandWeight[(size_t) p];
+}
+
+void VisualizerComponent::updateThirdOctave()
+{
+    constexpr int n = SpectrumAnalyzer::spectrumPoints;
+
+    // Average in POWER (the energy in the band), not in dB: the analyzer's values are
+    // linear in dB, so a plain average of them would under-report a band with a peak.
+    prefixPower[0] = 0.0;
+
+    for (int p = 0; p < n; ++p)
+    {
+        const double db = (double) SpectrumAnalyzer::dbForNormalised(snapshot.fast[(size_t) p]);
+        prefixPower[(size_t) p + 1] = prefixPower[(size_t) p]
+                                    + (double) bandWeight[(size_t) p] * std::exp(db * kLn10Over10);
+    }
+
+    for (int p = 0; p < n; ++p)
+    {
+        const size_t lo  = (size_t) bandLo[(size_t) p];
+        const size_t hi1 = (size_t) bandHi[(size_t) p] + 1;
+
+        const double meanPower = (prefixPower[hi1] - prefixPower[lo]) / (prefixWeight[hi1] - prefixWeight[lo]);
+
+        const float db = meanPower > 0.0 ? (float) (10.0 * std::log10(meanPower))
+                                         : SpectrumAnalyzer::displayFloorDb;
+
+        thirdOctave[(size_t) p] = juce::jlimit(0.0f, 1.0f, SpectrumAnalyzer::normalisedForDb(db));
+    }
+
+    thirdOctaveDirty = false;
+}
+
+void VisualizerComponent::rebuildDashed(DashedCache& cache,
+                                        const std::array<float, SpectrumAnalyzer::spectrumPoints>& values,
+                                        const TraceStyle& style, juce::Rectangle<float> plot) const
+{
+    std::array<float, SpectrumAnalyzer::spectrumPoints> scaled {};
+
+    for (size_t i = 0; i < scaled.size(); ++i)
+        scaled[i] = juce::jlimit(0.0f, 1.0f, values[i] * appearance.sensitivity);
+
+    const juce::Path curve = buildCurve(scaled, plot);
+    const float dashes[] = { style.dashOn, style.dashOff };
+
+    cache.path.clear();
+    juce::PathStrokeType(style.thickness).createDashedStroke(cache.path, curve, dashes, 2);
+
+    cache.plot  = plot;
+    cache.gain  = appearance.sensitivity;
+    cache.valid = true;
+}
+
+void VisualizerComponent::refreshTraceCaches(juce::Rectangle<float> plot)
+{
+    const float gain = appearance.sensitivity;
+
+    // Only work for traces that are actually on screen: setSnapshot() runs for this
+    // mode even while another mode is showing, so nothing heavy may live there.
+    if (traceVisible[(size_t) TraceThirdOctave])
+    {
+        if (thirdOctaveDirty)
+        {
+            updateThirdOctave();
+            thirdOctaveCache.valid = false;
+        }
+
+        if (! thirdOctaveCache.valid || thirdOctaveCache.plot != plot || thirdOctaveCache.gain != gain)
+            rebuildDashed(thirdOctaveCache, thirdOctave, traceStyle(TraceThirdOctave), plot);
+    }
+
+    if (hasReference && traceVisible[(size_t) TraceReference])
+    {
+        if (! referenceCache.valid || referenceCache.plot != plot || referenceCache.gain != gain)
+            rebuildDashed(referenceCache, referenceValues, traceStyle(TraceReference), plot);
+    }
+}
