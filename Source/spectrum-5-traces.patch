+void VisualizerComponent::prepare(double newSampleRate)
+{
+    const double next = newSampleRate > 0.0 ? newSampleRate : 48000.0;
+
+    if (std::abs(next - sampleRate) > 0.5)
+    {
+        sampleRate = next;
+
+        // The point-to-frequency mapping depends on the sample rate, so a REFERENCE
+        // captured at the old rate would be drawn against the wrong frequencies.
+        // (Restarting capture at the SAME rate - a device switch, a reconnect - keeps it.)
+        clearReference();
+
+        rebuildThirdOctaveTables();
+        thirdOctaveDirty = true;
+        thirdOctaveCache.valid = false;
+    }
+
+    rebuildLegendText();
+    repaint();
+}
+
+void VisualizerComponent::rebuildLegendText()
+{
+    // AVG is the analyzer's one-pole follower, updated once per FFT block. Its
+    // time constant is therefore hop / (sampleRate * -ln(1 - coeff)) seconds -
+    // derived from the analyzer's own constants so the label stays true if they
+    // (or the sample rate) change.
+    const double blockSeconds = (double) SpectrumAnalyzer::hopSize / sampleRate;
+    const double avgTau = -blockSeconds / std::log(1.0 - (double) SpectrumAnalyzer::avgCoeff);
+
+    legendLabels[(size_t) TraceLive]     = "LIVE - current spectrum";
+    legendLabels[(size_t) TraceAverage]  = "AVG - " + juce::String(avgTau, 1) + " s smoothing";
+    legendLabels[(size_t) TracePeakHold] = "PEAK HOLD";
+
+    peakHoldHintLabel = "PEAK HOLD - click plot to clear";
+
+    legendLabels[(size_t) TraceReference] = "REFERENCE - frozen AVG";
+    referenceEmptyLabel = "REFERENCE - click to capture";
+    referenceWaitLabel  = "REFERENCE - needs audio";
+
+    // The smoothing window is 0.23 octave wide. Once that is narrower than one FFT bin
+    // (bin width / 0.2316), smoothing changes nothing, so state where it starts to matter.
+    const double binHz = sampleRate / (double) SpectrumAnalyzer::fftSize;
+    const double windowFraction = kHalfThirdOctave - 1.0 / kHalfThirdOctave;
+    const int    fromHz = juce::roundToInt((float) (binHz / windowFraction / 10.0)) * 10;
+
+    legendLabels[(size_t) TraceThirdOctave] = "1/3-OCT - smoothed above " + juce::String(fromHz) + " Hz";
+
+    // What the traces above are computed from. Bin width matters: below a few
+    // hundred Hz the curve is interpolated between only a handful of FFT bins.
+    footerLabel = juce::String(SpectrumAnalyzer::fftSize) + "-pt FFT - Hann - "
+                + juce::String(sampleRate / (double) SpectrumAnalyzer::fftSize, 1) + " Hz/bin";
+}
+
+VisualizerComponent::TraceStyle VisualizerComponent::traceStyle(Trace t) const
+{
+    const float brightness = juce::jlimit(0.3f, 1.0f, appearance.brightness);
+
+    switch (t)
+    {
+        case TraceLive:
+            return { kAccentColour.withAlpha(0.95f * brightness), 1.6f, true };
+
+        case TraceAverage:
+            return { juce::Colours::white.withAlpha(0.85f * brightness), 1.6f, false };
+
+        case TracePeakHold:
+            return { kPeakHoldColour.withAlpha(juce::jlimit(0.0f, 1.0f, appearance.peakIntensity * 0.75f)),
+                     1.0f, false };
+
+        case TraceReference:
+            return { kReferenceColour.withAlpha(0.9f * brightness), 1.4f, false, 7.0f, 4.0f };
+
+        case TraceThirdOctave:
+            return { kSmoothedColour.withAlpha(0.9f * brightness), 1.4f, false, 3.0f, 3.0f };
+
+        case kNumTraces:
+            break;
+    }
+
+    return { juce::Colours::white, 1.0f, false };
+}
